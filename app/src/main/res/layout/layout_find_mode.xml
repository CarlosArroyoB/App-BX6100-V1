<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layout_find"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:visibility="gone"
    android:background="#EFEFEF">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Modo Búsqueda"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_gravity="center"
        android:layout_marginBottom="16dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <EditText
            android:id="@+id/et_target_epc"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Ingrese o pegue el EPC a buscar"
            android:background="#FFFFFF"
            android:padding="12dp"
            android:textSize="16sp"/>

        <Button
            android:id="@+id/btn_set_target"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Fijar"
            android:layout_marginStart="8dp"
            android:backgroundTint="#2196F3"/>
    </LinearLayout>

    <TextView
        android:id="@+id/tv_target_epc_display"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Objetivo: Ninguno"
        android:textColor="#555555"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="32dp"/>

    <!-- Wi-Fi Radar Indicator -->
    <ImageView
        android:id="@+id/iv_wifi_radar"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:layout_gravity="center"
        android:src="@drawable/ic_wifi"
        android:tint="#CCCCCC"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:id="@+id/tv_signal_percentage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="0%"
        android:textSize="48sp"
        android:textStyle="bold"
        android:gravity="center"
        android:textColor="#333333"
        android:layout_marginBottom="32dp"/>

    <Button
        android:id="@+id/btn_scan_find"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="MANTENER PRESIONADO O PULSAR PARA BUSCAR"
        android:backgroundTint="#FF5722"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:textSize="16sp"/>

</LinearLayout>
