<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EFEFEF">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/bottom_navigation">

        <!-- INVENTORY LAYOUT -->
        <LinearLayout
            android:id="@+id/layout_inventory"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Inventario de Habitaciones"
                android:textSize="24sp"
                android:textStyle="bold"
                android:layout_gravity="center"
                android:layout_marginBottom="16dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Habitación:"
                    android:textSize="18sp"
                    android:layout_marginEnd="8dp"/>

                <Spinner
                    android:id="@+id/spinner_rooms"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="#FFFFFF"
                    android:padding="8dp"/>
            </LinearLayout>

            <Button
                android:id="@+id/btn_load_csv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Cargar CSV desde Descargas"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/tv_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Estado: Esperando..."
                android:textColor="#555555"
                android:layout_marginBottom="8dp"/>

            <Button
                android:id="@+id/btn_scan"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:text="MANTENER PRESIONADO O PULSAR PARA ESCANEAR"
                android:backgroundTint="#2196F3"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="16sp"
                android:layout_marginBottom="8dp"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_equipment"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="#FFFFFF"
                android:padding="4dp"/>

            <Button
                android:id="@+id/btn_save_inventory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Guardar Inventario"
                android:layout_marginTop="16dp"
                android:backgroundTint="#4CAF50"/>
        </LinearLayout>

        <!-- SETTINGS LAYOUT -->
        <LinearLayout
            android:id="@+id/layout_settings"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Configuración"
                android:textSize="24sp"
                android:textStyle="bold"
                android:layout_gravity="center"
                android:layout_marginBottom="32dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Potencia de Lectura/Escritura"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/tv_power_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="30 dBm"
                android:textSize="16sp"
                android:textColor="#555555"
                android:gravity="center"
                android:layout_marginBottom="8dp"/>

            <SeekBar
                android:id="@+id/seekbar_power"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="28"
                android:progress="25"
                android:layout_marginBottom="32dp"/>

            <Button
                android:id="@+id/btn_save_settings"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:text="Guardar Configuración"
                android:backgroundTint="#FF9800"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="16sp"/>

        </LinearLayout>

    </FrameLayout>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        app:menu="@menu/bottom_nav_menu"
        android:background="#FFFFFF"/>

</RelativeLayout>
